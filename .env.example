# BASELINE v2 — environment variables
# Copy to .env.local and fill in once real Supabase/Plaid accounts exist.
# Not required for `npm run test`, `npm run build`, or `npm run dev` in this
# pass — the UI shell reads from seeded local data, not these services.

# Supabase (Settings > API in your Supabase project)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Plaid (Team Settings > Keys in your Plaid dashboard)
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
# HTTPS URL Plaid POSTs webhooks to (see src/app/api/plaid/webhook). Set
# via Link token creation only — Plaid fixes this at Item creation the
# same way it fixes the requested transaction history window.
PLAID_WEBHOOK_URL=
